  {
   "id": "linux.timing.rdtsc_cpuid_jitter",
   "technique": "timing.cpuid_vmexit",
   "status": "implemented",
   "fix": {
    "layer": "hypervisor",
    "effort": 5,
    "how": "Calibrate on comparable bare metal and minimize exits and host scheduling noise. TSC offsetting/scaling and exit-cost compensation require coordinated hypervisor work; a static offset cannot remove per-exit cost and clock compensation must remain consistent across vCPUs and clocks.",
    "chimera": "cpuidmon -s changes CPUID values, not VM-exit latency; its handling can add cost. Xen TSC mode or vCPU pinning alone cannot erase that cost. Validate any Xen/DRAKVUF compensation against raw RDTSC, RDTSCP and OS clocks; retain residual-risk reporting."
   },
   "equivalents": {
    "pafish": [
     "cpu_rdtsc_force_vmexit"
    ]
   },
   "description": "Frozen v1 Linux native-helper median RDTSC/CPUID timing, retained for compatibility. New robust sampling is linux.timing.rdtsc_cpuid_vmexit; its parameters do not apply to this legacy Python check.",
   "severity": "high",
   "references": [
    "https://github.com/ayoubfaouzi/al-khaser/blob/master/al-khaser/TimingAttacks/timing.cpp",
    "https://github.com/a0rtega/pafish/blob/master/pafish/cpu.c",
    "https://www.itl.nist.gov/div898/handbook/eda/section3/eda35h.htm",
    "https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html"
   ],
