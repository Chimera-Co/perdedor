   "id": "linux.env.cpu_brand_string",
   "technique": "cpu.brand_string",
   "status": "implemented",
   "fix": {
    "layer": "hypervisor",
    "effort": 4,
    "how": "Present a coherent CPU policy: match vendor, brand, feature dependencies, cache and topology to the configured vCPUs and real model. Do not advertise instructions the guest cannot execute.",
    "chimera": "Validate Xen CPUID policy together with cpuidmon -s. Host-derived SMBIOS does not change CPUID. Test both guests and every advertised CPU leaf after masking."
   },
   "equivalents": {
    "vmaware": [
     "CPU_BRAND"
    ],
    "pafish": [
     "qemu_cpu_name"
    ]
   },
