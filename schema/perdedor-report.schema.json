{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://perdedor.chimera.local/schema/perdedor-report.schema.json",
  "title": "PERDEDOR Platform Report",
  "description": "Unified report format emitted by every PERDEDOR agent (Windows, Linux, Android, macOS, iOS). Schema version 3 adds versioned tracking, host facts, environment profiles, and reproducibility seeds; versions 1 and 2 remain supported by the reader.",
  "type": "object",
  "required": [
    "schema_version",
    "perdedor_version",
    "platform",
    "hostname",
    "generated_at",
    "findings",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "scan_id": {
      "type": "string",
      "description": "Stable unique identifier for the scan run."
    },
    "perdedor_version": {
      "type": "string"
    },
    "agent_version": {
      "type": "string",
      "description": "Version of the agent binary or script that produced the report."
    },
    "catalog_version": {
      "type": "string",
      "description": "Version of the technique/check catalog the agent or scan was pinned to."
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows",
        "linux",
        "android",
        "macos",
        "ios"
      ]
    },
    "hostname": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "agent_metadata": {
      "type": "object",
      "description": "Free-form platform-specific identity info (OS build, device model, etc.) for report context only.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "seed": {
      "type": "integer",
      "description": "Random seed used for deterministic check ordering."
    },
    "host_facts": {
      "type": "object",
      "description": "Host environment facts captured during the scan.",
      "properties": {
        "os_build": {
          "type": "string",
          "description": "Operating system build or release version."
        },
        "cpu_model": {
          "type": "string",
          "description": "Processor model string (CPUID or OS-reported)."
        },
        "core_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of logical CPU cores."
        }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "description": "Environment profile block describing sandbox platform, hypervisor and instrumentation.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable environment profile name."
        },
        "os": {
          "type": "string",
          "description": "Guest operating system name."
        },
        "image_id": {
          "type": "string",
          "description": "Snapshot or golden image identifier."
        },
        "hypervisor": {
          "type": "string",
          "description": "Underlying hypervisor (e.g. Xen, KVM, VirtualBox, VMware, None)."
        },
        "monitor": {
          "type": "string",
          "enum": [
            "none",
            "out-of-guest",
            "in-guest"
          ],
          "description": "Malware monitoring mode."
        },
        "instrumentation": {
          "type": "string",
          "description": "Active in-guest or out-of-guest instrumentation (e.g. none, sysmon, drakvuf)."
        },
        "labels": {
          "type": "object",
          "description": "Free-form key-value labels for tracking and filtering.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "summary": {
      "$ref": "#/definitions/summary"
    },
    "selection": {
      "type": "object",
      "description": "Profile, only/skip patterns and parameters the run used."
    }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "category",
        "platform",
        "name",
        "description",
        "status",
        "severity"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable, dotted check id, e.g. 'linux.env.dmi_sys_vendor'.",
          "pattern": "^[a-z0-9]+\\.[a-z_]+\\.[a-z0-9_]+$"
        },
        "category": {
          "type": "string",
          "enum": [
            "environment_artifact",
            "timing",
            "behavioural_interaction",
            "design_specific"
          ],
          "description": "The four detection categories from the CHIMERA theoretical model (Ch.3)."
        },
        "platform": {
          "type": "string",
          "enum": [
            "windows",
            "linux",
            "android",
            "macos",
            "ios"
          ]
        },
        "name": {
          "type": "string",
          "description": "Short human title, e.g. 'SMBIOS system vendor string'."
        },
        "description": {
          "type": "string",
          "description": "What the check does and why it matters."
        },
        "status": {
          "type": "string",
          "enum": [
            "clean",
            "detected",
            "error",
            "skipped"
          ],
          "description": "clean = no tell found; detected = evasion tell found (BAD); error = probe could not run; skipped = not applicable on this host."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Real-world significance if detected -- mirrors the KVM hardening report's per-flag justification approach, not just pass/fail."
        },
        "evidence": {
          "description": "Raw observed value(s) supporting the status, for analyst review.",
          "type": [
            "string",
            "object",
            "array",
            "null"
          ]
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ],
          "description": "Suggested hardening-profile change to close this gap, so findings feed back into CHIMERA hardening rather than only being reported."
        },
        "error_detail": {
          "type": [
            "string",
            "null"
          ],
          "description": "Populated when status == error."
        },
        "technique": {
          "type": "string",
          "description": "Catalog technique key (catalog/techniques.json), e.g. cpu.hypervisor_bit."
        },
        "class": {
          "type": "string",
          "description": "Catalog class (catalog/classes.json)."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Agent's confidence in the status (timing statistics, partial reads)."
        },
        "measurement": {
          "type": "object",
          "description": "Numeric measurements behind the verdict."
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "clean",
        "detected",
        "errored",
        "skipped",
        "raw_score",
        "weighted_score"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "clean": {
          "type": "integer",
          "minimum": 0
        },
        "detected": {
          "type": "integer",
          "minimum": 0
        },
        "errored": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "raw_score": {
          "type": "string",
          "description": "VMAware-style 'clean/total' string, e.g. '91/93'."
        },
        "weighted_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Severity-weighted cleanliness score 0-100 (100 = nothing detected). See perdedor_common.scoring."
        }
      }
    }
  }
}
